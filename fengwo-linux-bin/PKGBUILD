# Maintainer: Stark Wu <wstarcn-2018 at outlook dot com>
pkgname=fengwo-linux-bin
_pkgname=fengwo
pkgver=1.0.0_7
pkgrel=1
epoch=1
pkgdesc="Fengwo Linux client powered by Clash Verge Rev"
arch=('x86_64' 'aarch64')
url="https://buy2.fengwo.org"
license=('unknown')
depends=('openssl' 'ca-certificates' 'webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'polkit')
provides=('clash-verge' 'fengwo-linux')
conflicts=('clash-verge' 'clash-verge-bin' 'clash-verge-rev' 'clash-verge-rev-bin'
           'clash-verge-rev-git' 'clash-verge-rev-alpha' 'clash-verge-rev-alpha-bin')
options=(!strip)
source=("https://picture.ynmf.online/Fengwo-Linux-universal.run")
sha256sums=('c60932be8d629989f85e3079af1d01519fbffa3773a662e0e84b20f1f18af85a')

prepare() {
    local _arch script payload_sha256 payload_line

    # Check architecture
    case "$CARCH" in
        x86_64) _arch=x86_64 ;;
        aarch64) _arch=aarch64 ;;
        *) printf 'Unsupported architecture: %s\n' "$CARCH" >&2; exit 1 ;;
    esac

    # Prepare payload.tar.gz
    script="${srcdir}/Fengwo-Linux-universal.run"
    payload_sha256="$(awk -F"'" '/^payload_sha256=/ {print $2; exit}' "${script}")"
    payload_line=$(awk '/^__FENGWO_PAYLOAD__$/ { print NR + 1; exit }' "${script}")
    [ -n "${payload_line}" ] || { printf 'Installer payload is missing.\n' >&2; exit 1; }
    tail -n +"${payload_line}" "${script}" > "${srcdir}/payload.tar.gz"

    # Verify payload integrity
    printf '%s  %s\n' "${payload_sha256}" "${srcdir}/payload.tar.gz" | sha256sum -c - > /dev/null || exit 1
    local -a entries=()
    mapfile -t entries < <(tar -tzf "${srcdir}/payload.tar.gz")
    for entry in "${entries[@]}"; do
        case "${entry}" in
            ./|./SHA256SUMS|"./${_pkgname}-x86_64.deb"|"./${_pkgname}-aarch64.deb"|"./${_pkgname}-x86_64.rpm"|"./${_pkgname}-aarch64.rpm") ;;
            *) printf 'Unexpected archive entry: %s\n' "${entry}" >&2; exit 1 ;;
        esac
    done

    # Extract payload
    tar -xzf "${srcdir}/payload.tar.gz" -C "${srcdir}" --no-same-owner --no-same-permissions
    (cd "${srcdir}" && sha256sum -c SHA256SUMS > /dev/null) || exit 1
    bsdtar -xf "${srcdir}/${_pkgname}-${_arch}.deb" -C "${srcdir}" data.tar.xz
}

package() {
    tar -xf "${srcdir}/data.tar.xz" -C "${pkgdir}"
    mv "${pkgdir}/usr/lib/Fengwo Linux" "${pkgdir}/usr/lib/fengwo-linux"
    ln -s fengwo-linux "${pkgdir}/usr/lib/Fengwo Linux"
    mv "${pkgdir}/usr/share/applications/Fengwo Linux.desktop" "${pkgdir}/usr/share/applications/fengwo-linux.desktop"
}
